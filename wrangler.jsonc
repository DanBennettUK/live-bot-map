{
  "name": "live-bot-map",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-19",
  "account_id": "5bd426d03cc6f3ca12c9efc1c5f4ef83",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/status.json"]
  },
  "kv_namespaces": [
    {
      "binding": "FEED",
      "id": "09f22c45aada44d798d8f6e7b401107b"
    }
  ]
}
