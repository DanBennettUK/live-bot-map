{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://live-bot-map.dan-5bd.workers.dev/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://live-bot-map.dan-5bd.workers.dev/:path*",
      "permanent": true
    }
  ]
}
